# Copy to .env and fill in. Never commit the real .env.
PORT=3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/soen

# Long random string used to sign login tokens
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_AI_KEY=your-gemini-key

# Optional: override the AI models (comma-separated fallbacks)
# GOOGLE_AI_MODEL=gemini-flash-latest
# GOOGLE_AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# Allowed frontend origin(s), comma-separated. Leave empty in local
# development to allow any origin.
CLIENT_URL=

# Optional. Without Redis, logout relies on tokens expiring (24h).
# Managed provider:
# REDIS_URL=rediss://default:password@host:6379
# Or a classic host/port setup:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
